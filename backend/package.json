{
  "name": "lms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Library Management System - backend (Express + Mongoose + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:local": "node scripts/dev-local.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node seed.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "typecheck": "tsc --noEmit",
    "check:db": "node scripts/check-db.js",
    "check:layering": "node scripts/check-layering.js",
    "bench:populate": "ts-node scripts/bench-populate.ts",
    "bench:bcrypt": "ts-node scripts/bench-bcrypt.ts",
    "demo:idor": "ts-node scripts/idor-demo.ts",
    "db:peek": "node scripts/db-peek.js",
    "tunnel": "node scripts/tunnel.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
